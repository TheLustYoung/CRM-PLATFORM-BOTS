# Copy to .env on the server and replace every CHANGE_ME value.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://media:CHANGE_ME_RANDOM_DATABASE_PASSWORD@postgres:5432/media
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# One BotFather token and one internal service key per bot.
VIDEO_BOT_TOKEN=
MEDIA_BOT_TOKEN=
FILES_BOT_TOKEN=
VIDEO_SERVICE_KEY=CHANGE_ME_VIDEO_SERVICE_KEY_32_CHARS
MEDIA_SERVICE_KEY=CHANGE_ME_MEDIA_SERVICE_KEY_32_CHARS
FILES_SERVICE_KEY=CHANGE_ME_FILES_SERVICE_KEY_32_CHARS

# Public addresses (configured in Plesk, see docs/PLESK.md)
ADMIN_ORIGIN=https://admin.example.com
PUBLIC_FILES_URL=https://files.example.com
COOKIE_SECURE=true
# Localhost ports published for Plesk (change if already used by another application on the server)
API_PORT=8000
DASHBOARD_PORT=8080
API_INTERNAL_URL=http://api:8000

# File storage: local (server disk, Docker volume files-data) or s3 (any S3-compatible service,
# or the bundled MinIO started with: docker compose --profile minio up -d)
STORAGE_BACKEND=local
STORAGE_DIR=/data/files
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=media-storage
S3_SECRET_KEY=CHANGE_ME_RANDOM_STORAGE_SECRET
S3_BUCKET=media
S3_REGION=us-east-1

# Outgoing requests of the workers pass this proxy, which refuses private/internal addresses (SSRF protection).
EGRESS_PROXY=http://egress:3128
DEFAULT_LANGUAGE=en
WORKER_CONCURRENCY=2
JOB_TIMEOUT=900
MAX_DOWNLOAD_BYTES=2000000000
MAX_UPLOAD_BYTES=19000000
TELEGRAM_RECEIVE_BYTES=19000000
TELEGRAM_SEND_BYTES=49000000
RETENTION_DAYS=7
DAILY_JOBS=20
MIN_FREE_DISK_BYTES=300000000
TEMP_ROOT=/data/files/.work

# Optional error tracking: a Sentry (or self-hosted GlitchTip) DSN. Empty = no reports are sent.
SENTRY_DSN=
ENVIRONMENT=production
